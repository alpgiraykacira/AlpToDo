# Supabase dashboard → Project Settings → API
# İkisini de doldurmazsan uygulama "demo modunda" açılır (giriş yok, veri sadece tarayıcıda).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Yeni projelerde "publishable key", eskilerde "anon key". İkisi de çalışır.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# service_role / secret key'i BURAYA KOYMA. Uygulama onu hiç kullanmaz.
